# KiCad local, temporary and backup files
*-backups/
*.kicad_prl
fp-info-cache
*.lck
*.bak
*.bck
~*
_autosave-*
\#auto_saved_files\#
.history/
_restore_backup_*/
# KiCad check reports (ERC.rpt, DRC.rpt, ...) and default-named plots
*.rpt
hardware/DevBoard/MonolithDev.pdf
hardware/Production/Monolith.pdf
# Fab outputs are tracked only as the zipped order package (hardware/*/fab/*.zip)
hardware/*/fab/gerbers/
hardware/**/*.gbr
hardware/**/*.gbrjob
hardware/**/*.drl

# Firmware build outputs (build/ and tools.mak are in firmware/.gitignore)
firmware/**/*.out
firmware/**/*.hex
firmware/**/*.map
firmware/**/*.obj

# Python
__pycache__/
*.pyc

# Editor and OS
.~lock.*#
*.log
.DS_Store
Thumbs.db

# Local agent settings, skill-creator eval output and reviewers' scratch work
**/.claude/settings.local.json
.claude/skills/*-workspace/
.claude/skills/*-review-iter*.html
docs/devboard/review4/scratch-*/

# STEP export output (hardware/mechanical/monolith_step.py)
hardware/mechanical/step/

# Retired enclosure outputs (removed 2026-10-29; monolith_shell.py / monolith_parts.py still write them here)
hardware/mechanical/retired/*
!hardware/mechanical/retired/README.md
