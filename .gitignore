# KiCad local, temporary and backup files
*-backups/
*.kicad_prl
fp-info-cache
*.lck
*.bak
*.bck
~*
_autosave-*
.history/
_restore_backup_*/
# KiCad check reports and default-named plots
ERC.rpt
DRC.rpt
*.rpt
hardware/DevBoard/MonolithDev.pdf
hardware/Production/Monolith.pdf
# Fab outputs are tracked only as the zipped order package (hardware/*/fab/*.zip)
hardware/*/fab/gerbers/
hardware/**/*.gbr
hardware/**/*.gbrjob
hardware/**/*.drl

# Firmware build outputs and local tool paths (see firmware/.gitignore)
firmware/build/
firmware/**/*.out
firmware/**/*.hex
firmware/**/*.map
firmware/**/*.obj
firmware/tools.mak

# Python
__pycache__/
*.pyc

# Editor and OS
.~lock.*#
*.log
.DS_Store
Thumbs.db

# Local agent settings and reviewers' scratch work
**/.claude/settings.local.json
docs/devboard/review4/scratch-*/

# STEP export output (hardware/mechanical/monolith_step.py)
hardware/mechanical/step/
