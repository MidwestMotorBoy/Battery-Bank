	(text "J108 PACK- and J112 PACK+: 16 AWG leads in 1.7 mm plated holes. J109-J111: cell tap wires.\nConnect with USB unplugged, in order: PACK-, CELL1, CELL2, CELL3, PACK+ (note 15)."
		(exclude_from_sim no)
		(at 22.86 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "d6ff1902-834d-4378-8533-fcb0ae3ec8b3")
	)
