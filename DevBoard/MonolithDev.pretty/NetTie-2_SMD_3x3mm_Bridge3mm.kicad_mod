(footprint "NetTie-2_SMD_3x3mm_Bridge3mm"
	(version 20241229)
	(generator "make_footprints.py")
	(layer "F.Cu")
	(descr "Net tie, two 3 x 3 mm pads joined by 3 mm copper, for a ~10 A link")
	(tags "net tie bridge high current")
	(property "Reference" "REF**" (at 0 -2.5 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
	(property "Value" "NetTie-2_SMD_3x3mm_Bridge3mm" (at 0 2.5 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
	(attr smd)
	(net_tie_pad_groups "1,2")
	(pad "1" smd rect (at -2 0) (size 3 3) (layers "F.Cu" "F.Mask"))
	(pad "2" smd rect (at 2 0) (size 3 3) (layers "F.Cu" "F.Mask"))
	(fp_poly (pts (xy -2 -1.5) (xy 2 -1.5) (xy 2 1.5) (xy -2 1.5)) (stroke (width 0) (type solid)) (fill yes) (layer "F.Cu"))
	(fp_rect (start -3.75 -1.75) (end 3.75 1.75) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
	(fp_text user "${REFERENCE}" (at 0 0 0) (layer "F.Fab") (effects (font (size 0.5 0.5) (thickness 0.08))))
)
