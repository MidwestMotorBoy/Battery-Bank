	)
	(text "CELL STACK (4S)"
		(exclude_from_sim no)
		(at 22.86 35.56 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "7cd55707-768c-41d2-a8dc-9420b3ba9024")
	)
	(text "NOTES\n1. CELL_N = gauge VSS (cell 1N tab). GND = system ground, on the far side of RS101.\n2. Kelvin-route SRP/SRN from the RS101 pads; R107/R108/C106 at the IC.\n3. VC taps are separate thin traces from the cell end of each holder contact;\n    VC4 from CELL_P_RAW (before F101) so fuse drop is not read as cell voltage.\n4. TS2-TS4, PTC, PTCEN, PRES, DISP, FUSE tied to VSS per datasheet; disable in data flash.\n5. VCC fed from FET common drain via R106 (TI R13). PACK sense via R113 10k (TI R15).\n6. BAT fed from CELL_P (after fuse, before FETs) via D101 + R105."
		(exclude_from_sim no)
		(at 266.7 226.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "89b0cf56-9ded-4344-bef1-affe1323f8fe")
	)
	(text "GAS GAUGE  BQ40Z50-R2  (TI fig. 9-1)"
		(exclude_from_sim no)
		(at 137.16 96.52 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "8a3a566c-f33f-4c14-a5f4-a07a27bac5f6")
	)
	(text "Holders BT101-BT104 OR welded pack on J101 - never both.\nCheck each cell at TP103-TP105 before fitting F101."
		(exclude_from_sim no)
		(at 22.86 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "d6ff1902-834d-4378-8533-fcb0ae3ec8b3")
	)
