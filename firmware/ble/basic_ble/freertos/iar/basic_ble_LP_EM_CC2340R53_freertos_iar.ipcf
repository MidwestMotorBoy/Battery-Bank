        <path>$SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR$/source/third_party/freertos/portable/IAR/ARM_CM0</path>
    </includePath>

    <defines>
        <define>ICALL_NO_APP_EVENTS</define>
        <define>MBEDTLS_CONFIG_FILE=&quot;configs/config-hsm.h&quot;</define>
        <define>MBEDTLS_PSA_CRYPTO_CONFIG_FILE=&quot;configs/config-psa-crypto-hsm.h&quot;</define>
